{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roofing-rugenio-webpage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
